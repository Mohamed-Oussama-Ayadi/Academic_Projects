<AnchorPane id="AnchorPane" prefHeight="649.0" prefWidth="1001.0" styleClass="parent" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ForgetPassword">
   <children>
      <ImageView fitHeight="671.0" fitWidth="1028.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/arriere_plan.png" />
