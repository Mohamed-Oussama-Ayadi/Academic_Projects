      </ImageView>
      <TextField fx:id="mail" layoutX="322.0" layoutY="233.0" prefHeight="46.0" prefWidth="410.0" promptText="Your E-mail" />
      <Button fx:id="code_button" layoutX="446.0" layoutY="480.0" mnemonicParsing="false" onAction="#handleVerifyCode" prefHeight="46.0" prefWidth="134.0" style="-fx-background-color: #fea116;" text="Verify">
         <font>
            <Font name="System Bold" size="19.0" />
         </font>
      </Button>
      <TextField fx:id="code" layoutX="403.0" layoutY="404.0" prefHeight="46.0" prefWidth="221.0" promptText="code" />
      <Button fx:id="send_mail" layoutX="608.0" layoutY="309.0" mnemonicParsing="false" onAction="#handleResetPassword" prefHeight="46.0" prefWidth="169.0" style="-fx-background-color: #fea116;" text="Send Mail">
         <font>
            <Font name="System Bold" size="19.0" />
