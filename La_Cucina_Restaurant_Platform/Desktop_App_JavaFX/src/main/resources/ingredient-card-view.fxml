<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="122.0" prefWidth="587.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.IngredientCardView">
   <children>
      <ImageView fx:id="imgingredient" fitHeight="95.0" fitWidth="118.0" layoutX="22.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true" />
      <Label fx:id="nomingredient" layoutX="153.0" layoutY="39.0" prefHeight="45.0" prefWidth="328.0" text="Label">
         <font>
            <Font name="System Bold" size="22.0" />
         </font>
      </Label>
      <ImageView fx:id="minusimg" fitHeight="53.0" fitWidth="61.0" layoutX="502.0" layoutY="35.0" onMouseClicked="#minus" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/minus.png" />
         </image>
      </ImageView>
      <ImageView fx:id="plusimg" fitHeight="53.0" fitWidth="61.0" layoutX="503.0" layoutY="35.0" onMouseClicked="#plus" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@Images/plus.png" />
         </image>
      </ImageView>
      <Label fx:id="prixingredient" layoutX="152.0" layoutY="80.0" text="Label" textFill="#fea116">
         <font>
            <Font name="System Bold" size="25.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
