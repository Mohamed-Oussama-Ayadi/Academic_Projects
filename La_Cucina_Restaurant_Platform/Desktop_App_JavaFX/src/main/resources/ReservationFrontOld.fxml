<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="479.0" prefWidth="664.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReservationFront">
   <children>
      <TextField fx:id="nbrPersonnesTextField" layoutX="94.0" layoutY="126.0" prefHeight="43.0" prefWidth="243.0" promptText="Nombre de Personnes" />
      <DatePicker fx:id="datePicker" layoutX="94.0" layoutY="185.0" prefHeight="43.0" prefWidth="243.0" promptText="Date" />
      <Label layoutX="250.0" layoutY="50.0" prefHeight="38.0" prefWidth="222.0" text="Book a table">
         <font>
            <Font name="Bodoni MT Italic" size="30.0" />
         </font>
      </Label>
      <ComboBox fx:id="HoraireBox" layoutX="382.0" layoutY="185.0" prefHeight="43.0" prefWidth="166.0" promptText="Horaire" />
      <Label layoutX="27.0" layoutY="14.0" prefHeight="38.0" prefWidth="222.0" text="Front">
         <font>
            <Font name="Bodoni MT Italic" size="30.0" />
         </font>
      </Label>
      <Button fx:id="ReservationButton" layoutX="437.0" layoutY="374.0" mnemonicParsing="false" onAction="#ReservationButtonOn" prefHeight="43.0" prefWidth="150.0" text="Book a table">
         <font>
            <Font name="System Bold" size="16.0" />
         </font>
      </Button>
      <ComboBox fx:id="EmplacementBox" layoutX="94.0" layoutY="250.0" prefHeight="43.0" prefWidth="243.0" promptText="Emplacement" />
   </children>
</AnchorPane>
