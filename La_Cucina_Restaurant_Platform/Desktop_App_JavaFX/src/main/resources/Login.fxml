            </TextField>
            <Button fx:id="SeConnecterButton" layoutX="114.0" layoutY="376.0" mnemonicParsing="false" onAction="#LoginButtonOnAction" prefHeight="36.0" prefWidth="216.0" style="-fx-background-color: #0F172B;" text="Login" textFill="WHITE">
