{% extends 'base.html.twig' %}

{% block title %}Reclamation{% endblock %}

{% block body %}
    <h1 style="text-align: center;">Reclamation</h1>

    <table class="table"style="background-color: #FEFCF3; border-radius: 5px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); border-collapse: collapse; width: 100%;text-align: center; ">

        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ reclamation.id }}</td>
        </tr>
        <tr>
            <th>Description</th>
            <td>{{ reclamation.description }}</td>
        </tr>
        <tr>
            <th>Etat</th>
            <td>{{ reclamation.etat ? 'Yes' : 'No' }}</td>
        </tr>
        <tr>
            <th>DateCreation</th>
            <td>{{ reclamation.dateCreation ? reclamation.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
            <th>Type</th>
            <td>{{ reclamation.type }}</td>
        </tr>
        <tr>
            <th>GenerateWithAi</th>
            <td>{{ reclamation.generateWithAi ? 'Yes' : 'No' }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('app_reclamation_index') }}">back to list</a>

    <a href="{{ path('app_reclamation_edit', {'id': reclamation.id}) }}">edit</a>

    {{ include('reclamation/_delete_form.html.twig') }}
{% endblock %}
