{% extends 'base.html.twig' %}

{% block title %}New Reclamation{% endblock %}

{% block body %}


    {{ include('reclamation/_form.html.twig') }}

    <a href="{{ path('app_reclamation_index') }}">back to list</a>
    <style>
        .styled-button {
            background-color: #BEE5B4;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            cursor: pointer;
            margin-top: 20px;
        }

        .styled-button:hover {
            background-color: #A5D6A7; /* Changez la couleur au survol */
        }


        .styled-button a {
            color: inherit; /* Assure que la couleur du lien reste blanche */
            text-decoration: none; /* Supprime le soulignement par défaut du lien */
        }


        h1 {
            text-align: center;
        }
    </style>
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}
{% endblock %}
