    <div style="margin: 20px;">
        <table class="table custom-table">
            <thead>
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>Description</th>
                <th>État</th>
                <th>Date de création</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for reclamation in reclamations %}
                <tr {% if not reclamation.etat %}style="color: #F26A77;"{% endif %}>
                    <td>{{ reclamation.id }}</td>
                    <td>{{ reclamation.type }}</td>
                    <td>{{ reclamation.description }}</td>

                    <td>{{ reclamation.etat ? 'Traitée' : 'Non traitée' }}</td>
                    <td>{{ reclamation.dateCreation ? reclamation.dateCreation|date('Y-m-d') : '' }}</td>
                    <td>

                        {% if reclamation.etat %}
                            <a href="{{ path('app_reclamation_show2', {'id': reclamation.id}) }}" class="btn btn-info"><i class="fas fa-eye"></i> Voir</a>
                            <a href="{{ path('app_reclamation_reponse_show2', {'id': reclamation.id}) }}" class="btn btn-warning"><i class="fas fa-reply"></i> Réponse</a>
                        {% else %}
                            <a href="{{ path('app_reclamation_show2', {'id': reclamation.id}) }}" class="btn btn-info"><i class="fas fa-eye"></i> Voir</a>
                            <a href="{{ path('app_reponse_new', {'id': reclamation.id}) }}" class="btn btn-success"><i class="fas fa-comments"></i> Répondre</a>
                        {% endif %}

                    </td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="6">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="pagination" style=" display: flex; justify-content: center; margin-top: 20px;">
            {{ knp_pagination_render(reclamations) }}
        </div>
    </div>
{% endblock %}